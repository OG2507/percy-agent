<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PercyAgent</AssemblyName>
    <RootNamespace>PercyAgent</RootNamespace>
    <!-- MUST stay false. Set true originally to keep the app portable, but WPF's
         font machinery calls new CultureInfo("en") inside the static constructor
         of MS.Internal.FontCache.MajorLanguages, which is illegal in invariant
         mode. A failed type initializer is cached for the life of the process, so
         EVERY subsequent text measurement throws and the window dies the moment
         you interact with it. Cost an afternoon on 2026-08-07 — the symptom looks
         exactly like a corrupt font cache, and it isn't. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The queue is still reachable over localhost so local processes
         (Percy Worker, scripts) can push work in. The app itself PULLS
         from remote systems, so nothing needs to reach into this machine. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>
</Project>
