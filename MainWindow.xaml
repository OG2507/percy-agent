<Window x:Class="PercyAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Percy Agent" Height="820" Width="1020"
        MinHeight="520" MinWidth="720"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

  <Grid Margin="26,22,26,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header: the count is the point. A number you can get to zero. -->
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Percy Agent" FontSize="13" Foreground="{StaticResource Muted}"
                   FontWeight="SemiBold" Margin="0,0,10,0"/>
        <TextBlock x:Name="DbHint" FontSize="11" Foreground="#5C6472" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock x:Name="Headline" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,2"/>
      <TextBlock x:Name="Subhead" FontSize="13" Foreground="{StaticResource Muted}"/>
    </StackPanel>

    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
    <TabItem Header="Decisions">

    <!-- The queue -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
      <StackPanel>
        <ItemsControl x:Name="QueueList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelEdge}"
                      BorderThickness="1" CornerRadius="10" Padding="18,15" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <!-- Category badge -->
                  <Border Grid.Column="0" VerticalAlignment="Top" CornerRadius="5"
                          Background="{Binding BadgeBrush}" Padding="8,3" Margin="0,2,14,0">
                    <TextBlock Text="{Binding CategoryLabel}" FontSize="10.5" FontWeight="Bold"
                               Foreground="#14161A" HorizontalAlignment="Center"/>
                  </Border>

                  <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                      <TextBlock Text="{Binding Sender}" FontSize="12" Foreground="{StaticResource Muted}"/>
                      <TextBlock Text="  ·  " Foreground="#4A5160" FontSize="12"/>
                      <TextBlock Text="{Binding Source}" FontSize="12" Foreground="#5C6472"/>
                      <TextBlock Text="  ·  " Foreground="#4A5160" FontSize="12"/>
                      <TextBlock Text="{Binding Age}" FontSize="12" Foreground="#5C6472"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Subject}" FontSize="15.5" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding Reason}" FontSize="12.5" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" Margin="0,5,14,0"/>
                  </StackPanel>

                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open" Style="{StaticResource Action}" Tag="{Binding Id}"
                            Click="Open_Click" Visibility="{Binding LinkVisibility}"/>
                    <Button Content="Snooze" Style="{StaticResource Action}" Tag="{Binding Id}"
                            Click="Snooze_Click"/>
                    <Button Content="Done" Style="{StaticResource Primary}" Tag="{Binding Id}"
                            Click="Done_Click"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Shown when the list is empty -->
        <Border x:Name="EmptyState" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelEdge}"
                BorderThickness="1" CornerRadius="10" Padding="28" Visibility="Collapsed">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="You're finished." FontSize="19" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Nothing else needs you today." FontSize="13"
                       Foreground="{StaticResource Muted}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    </TabItem>

    <!-- Work: the production side. Percy Worker runs on this machine because the
         GPU is here, so this launches and watches it rather than replacing it. -->
    <TabItem Header="Work">
      <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Where things stand -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelEdge}"
                BorderThickness="1" CornerRadius="10" Padding="18">
          <StackPanel>
            <TextBlock Text="Where things stand" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
              <StackPanel Margin="0,0,34,0">
                <TextBlock x:Name="StatAwaiting" Text="—" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="waiting for you" FontSize="11.5" Foreground="{StaticResource Muted}"/>
              </StackPanel>
              <StackPanel Margin="0,0,34,0">
                <TextBlock x:Name="StatComfy" Text="—" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="the 5090" FontSize="11.5" Foreground="{StaticResource Muted}"/>
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="WorkError" FontSize="11.5" Foreground="#E05A5A"
                       Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10">
          <Button x:Name="RunBtn" Content="Run Percy" Style="{StaticResource Action}" Click="Run_Click"/>
          <Button Content="Approvals in browser" Style="{StaticResource Action}"
                  Click="OpenApprovals_Click" Margin="8,0,0,0"/>
          <Button Content="Refresh" Style="{StaticResource Action}" Click="RefreshWork_Click" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- What the worker is saying, as it says it -->
        <Border Grid.Row="2" Background="#0E1116" BorderBrush="{StaticResource PanelEdge}"
                BorderThickness="1" CornerRadius="10" Padding="14">
          <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="WorkLog" FontFamily="Consolas" FontSize="12"
                       Foreground="#9BA3B0" TextWrapping="Wrap"
                       Text="Percy hasn't run yet. It asks Baldrick for local jobs, makes them on the 5090, uploads them and sends them to the approval queue — then stops."/>
          </ScrollViewer>
        </Border>
      </Grid>
    </TabItem>

    <!-- Methods as CARDS (Stephen 2026-08-11: no more spreadsheets). This is
         the LOCAL FALLBACK map only — the truth lives in Baldrick's Central
         Catalogue (the method on each output type), which is what the worker
         now prefers. Read here, edit there. -->
    <TabItem Header="Methods">
      <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
          <Button Content="Open the Central Catalogue" Style="{StaticResource Primary}" Click="OpenCatalogue_Click"/>
          <Button Content="Reload" Style="{StaticResource Action}" Click="ReloadMethods_Click" Margin="8,0,0,0"/>
          <TextBlock x:Name="MethodsHint" VerticalAlignment="Center" FontSize="13"
                     Foreground="{StaticResource Muted}" Margin="12,0,0,0"
                     Text="The truth lives in Baldrick's catalogue — this is the local fallback copy."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
          <ItemsControl x:Name="MethodCards">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelEdge}"
                        BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,10">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border CornerRadius="5" Background="{Binding BadgeBrush}" Padding="8,3" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="Bold" Foreground="#14161A"/>
                      </Border>
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Sub}" FontSize="12.5" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#8A93A3"
                               TextWrapping="Wrap" Margin="0,4,0,0" FontFamily="Consolas"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </TabItem>

    <!-- Baldrick: the CONTROLLER as CARDS (Stephen's design 2026-08-11) —
         one thing per card, a badge, a sentence, buttons. Batch stories,
         needs-you decisions, rendering-now with checklist progress. -->
    <TabItem Header="Baldrick">
      <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
          <!-- THE RUNNER BAR: what Percy is doing, and the two buttons that
               start and stop it. Play runs the one queue; Pause lets it
               finish the job it is on and then stop. -->
          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelEdge}"
                  BorderThickness="1" CornerRadius="6" Padding="14,11" Margin="0,0,0,10">
            <!-- Buttons FIRST, on the left. They were on the right and fell off
                 the edge on a narrow window — the two controls that matter most
                 were the first thing to disappear. -->
            <StackPanel Orientation="Horizontal">
              <Button x:Name="RunnerPlay" Content="▶  Play" Style="{StaticResource Action}"
                      Click="RunnerPlay_Click"
                      ToolTip="Start Percy. It works job after job until there is nothing left."/>
              <Button x:Name="RunnerPause" Content="❚❚  Pause" Style="{StaticResource Action}"
                      Margin="8,0,0,0" Click="RunnerPause_Click"
                      ToolTip="Percy finishes the job it is on, reports it, then stops."/>
              <TextBlock x:Name="RunnerState" FontSize="15" FontWeight="SemiBold"
                         VerticalAlignment="Center" Margin="16,0,0,0" Text="Percy: checking…"/>
              <TextBlock x:Name="RunnerDoing" FontSize="13" Foreground="{StaticResource Muted}"
                         VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" Text=""/>
            </StackPanel>
          </Border>

          <TextBlock x:Name="BaldrickStatus" FontSize="14" Foreground="{StaticResource Muted}"
                     Margin="0,0,0,8" Text="Connecting to Baldrick…"/>
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="BaldrickReason" Width="320" FontSize="13"
                     Background="{StaticResource Panel}" Foreground="{StaticResource Ink}"
                     BorderBrush="{StaticResource PanelEdge}" VerticalContentAlignment="Center"
                     ToolTip="Reason — required before Reject or Abandon, kept as the record"/>
            <TextBlock Text="reason (for reject/abandon)" FontSize="11" Foreground="#5C6472"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Button Content="Refresh" Style="{StaticResource Action}" Click="BaldrickRefresh_Click" Margin="16,0,0,0"/>
          </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
          <ItemsControl x:Name="BaldrickCards">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelEdge}"
                        BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" VerticalAlignment="Top" CornerRadius="5"
                            Background="{Binding BadgeBrush}" Padding="8,3" Margin="0,2,14,0">
                      <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="Bold"
                                 Foreground="#14161A" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                 TextWrapping="Wrap" Margin="0,0,14,0"/>
                      <TextBlock Text="{Binding Sub}" FontSize="12.5" Foreground="{StaticResource Muted}"
                                 TextWrapping="Wrap" Margin="0,4,14,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="Approve" Style="{StaticResource Primary}" Tag="{Binding}"
                              Visibility="{Binding CanApprove}" Click="BaldrickCardApprove_Click"/>
                      <Button Content="Reject" Style="{StaticResource Action}" Tag="{Binding}" Margin="6,0,0,0"
                              Visibility="{Binding CanReject}" Click="BaldrickCardReject_Click"/>
                      <Button Content="Retry" Style="{StaticResource Action}" Tag="{Binding}" Margin="6,0,0,0"
                              Visibility="{Binding CanRetry}" Click="BaldrickCardRetry_Click"/>
                      <Button Content="Abandon" Style="{StaticResource Action}" Tag="{Binding}" Margin="6,0,0,0"
                              Visibility="{Binding CanCancel}" Click="BaldrickCardCancel_Click"/>
                      <Button Content="Open" Style="{StaticResource Action}" Tag="{Binding}" Margin="6,0,0,0"
                              Visibility="{Binding CanOpen}" Click="BaldrickCardOpen_Click"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </TabItem>

    <!-- Run: start Baldrick's processes from here. The app is an extension of
         the website (Stephen, 2026-08-15: "I still can't go in and run things
         like the 12 month plan in it"). The server owns the list — nothing here
         hardcodes a process, so a new process appears on Reload, not a deploy. -->
    <TabItem Header="Run">
      <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Client" FontSize="13" Foreground="{StaticResource Muted}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <!-- The dropdown popup uses Windows' LIGHT chrome regardless of the
                 app's dark theme, so inherited light text vanished on it
                 (Stephen, 16 Aug: "light writing on a light background").
                 Dark text on the light popup; closed-box text explicit too. -->
            <ComboBox x:Name="RunClientBox" Width="280" FontSize="13"
                      VerticalContentAlignment="Center" Foreground="#14161A">
              <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                  <Setter Property="Foreground" Value="#14161A"/>
                  <Setter Property="Background" Value="White"/>
                </Style>
              </ComboBox.ItemContainerStyle>
            </ComboBox>
            <Button Content="Reload" Style="{StaticResource Action}"
                    Click="ReloadProcesses_Click" Margin="12,0,0,0"/>
          </StackPanel>
          <TextBlock x:Name="RunStatus" FontSize="13" Foreground="{StaticResource Muted}"
                     TextWrapping="Wrap" Margin="0,10,0,0"
                     Text="Loading the process list from Baldrick…"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
          <ItemsControl x:Name="RunGroups">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,14">
                  <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{StaticResource Muted}" Margin="2,0,0,8"/>
                  <ItemsControl ItemsSource="{Binding Processes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelEdge}"
                                BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,10">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                              <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold"
                                         TextWrapping="Wrap" Margin="0,0,14,0"/>
                              <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{StaticResource Muted}"
                                         TextWrapping="Wrap" Margin="0,4,14,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Run" Style="{StaticResource Primary}"
                                    VerticalAlignment="Center" Tag="{Binding}" Click="RunProcess_Click"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </TabItem>

    <!-- Chat: talk to Claude through the local CLI — the subscription pays for
         it, not API fees. The transcript streams as the reply arrives. -->
    <TabItem Header="Chat">
      <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
          <TextBlock Text="Runs on your Claude subscription via the local Claude CLI — same brain, no API fees."
                     FontSize="12" Foreground="{StaticResource Muted}"/>
          <TextBlock x:Name="ChatCliHint" FontSize="11" Foreground="#5C6472" Margin="0,3,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#0E1116" BorderBrush="{StaticResource PanelEdge}"
                BorderThickness="1" CornerRadius="10" Padding="14">
          <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="ChatLog" FontFamily="Consolas" FontSize="12.5"
                       Foreground="#C8CDD6" TextWrapping="Wrap"
                       Text="Checking for the Claude CLI…"/>
          </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="ChatInput" FontSize="13"
                   Background="{StaticResource Panel}" Foreground="{StaticResource Ink}"
                   BorderBrush="{StaticResource PanelEdge}" Padding="10,8"
                   VerticalContentAlignment="Center" KeyDown="ChatInput_KeyDown"/>
          <Button x:Name="ChatSend" Grid.Column="1" Content="Send" Style="{StaticResource Primary}"
                  Margin="8,0,0,0" Click="ChatSend_Click"/>
        </Grid>
      </Grid>
    </TabItem>
    </TabControl>

    <!-- Footer -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
      <Button Content="Refresh" Style="{StaticResource Action}" Click="Refresh_Click"/>
      <TextBlock x:Name="Footer" VerticalAlignment="Center" FontSize="12"
                 Foreground="{StaticResource Muted}" Margin="8,0,0,0"/>
    </StackPanel>
  </Grid>
</Window>
