<Window x:Class="PercyAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Percy Agent" Height="820" Width="1020"
        MinHeight="520" MinWidth="720"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

  <Grid Margin="26,22,26,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header: the count is the point. A number you can get to zero. -->
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Percy Agent" FontSize="13" Foreground="{StaticResource Muted}"
                   FontWeight="SemiBold" Margin="0,0,10,0"/>
        <TextBlock x:Name="DbHint" FontSize="13" Foreground="#5C6472" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock x:Name="Headline" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,2"/>
      <TextBlock x:Name="Subhead" FontSize="13" Foreground="{StaticResource Muted}"/>
    </StackPanel>

    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
    <TabItem Header="Decisions">

    <!-- The queue -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
      <StackPanel>
        <ItemsControl x:Name="QueueList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelEdge}"
                      BorderThickness="1" CornerRadius="10" Padding="18,15" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <!-- Category badge -->
                  <Border Grid.Column="0" VerticalAlignment="Top" CornerRadius="5"
                          Background="{Binding BadgeBrush}" Padding="8,3" Margin="0,2,14,0">
                    <TextBlock Text="{Binding CategoryLabel}" FontSize="10.5" FontWeight="Bold"
                               Foreground="#14161A" HorizontalAlignment="Center"/>
                  </Border>

                  <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                      <TextBlock Text="{Binding Sender}" FontSize="15" Foreground="{StaticResource Muted}"/>
                      <TextBlock Text="  ·  " Foreground="#4A5160" FontSize="15"/>
                      <TextBlock Text="{Binding Source}" FontSize="15" Foreground="#5C6472"/>
                      <TextBlock Text="  ·  " Foreground="#4A5160" FontSize="15"/>
                      <TextBlock Text="{Binding Age}" FontSize="15" Foreground="#5C6472"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Subject}" FontSize="15.5" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding Reason}" FontSize="12.5" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" Margin="0,5,14,0"/>
                  </StackPanel>

                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open" Style="{StaticResource Action}" Tag="{Binding Id}"
                            Click="Open_Click" Visibility="{Binding LinkVisibility}"/>
                    <Button Content="Snooze" Style="{StaticResource Action}" Tag="{Binding Id}"
                            Click="Snooze_Click"/>
                    <Button Content="Done" Style="{StaticResource Primary}" Tag="{Binding Id}"
                            Click="Done_Click"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Shown when the list is empty -->
        <Border x:Name="EmptyState" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelEdge}"
                BorderThickness="1" CornerRadius="10" Padding="28" Visibility="Collapsed">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="You're finished." FontSize="19" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Nothing else needs you today." FontSize="13"
                       Foreground="{StaticResource Muted}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    </TabItem>

    <!-- Work: the production side. Percy Worker runs on this machine because the
         GPU is here, so this launches and watches it rather than replacing it. -->
    <TabItem Header="Work">
      <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Where things stand -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelEdge}"
                BorderThickness="1" CornerRadius="10" Padding="18">
          <StackPanel>
            <TextBlock Text="Where things stand" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
              <StackPanel Margin="0,0,34,0">
                <TextBlock x:Name="StatAwaiting" Text="—" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="waiting for you" FontSize="11.5" Foreground="{StaticResource Muted}"/>
              </StackPanel>
              <StackPanel Margin="0,0,34,0">
                <TextBlock x:Name="StatComfy" Text="—" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="the 5090" FontSize="11.5" Foreground="{StaticResource Muted}"/>
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="WorkError" FontSize="11.5" Foreground="#E05A5A"
                       Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10">
          <Button x:Name="RunBtn" Content="Run Percy" Style="{StaticResource Action}" Click="Run_Click"/>
          <Button Content="Approvals in browser" Style="{StaticResource Action}"
                  Click="OpenApprovals_Click" Margin="8,0,0,0"/>
          <Button Content="Refresh" Style="{StaticResource Action}" Click="RefreshWork_Click" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- What the worker is saying, as it says it -->
        <Border Grid.Row="2" Background="#0E1116" BorderBrush="{StaticResource PanelEdge}"
                BorderThickness="1" CornerRadius="10" Padding="14">
          <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="WorkLog" FontFamily="Consolas" FontSize="15"
                       Foreground="#9BA3B0" TextWrapping="Wrap"
                       Text="Percy hasn't run yet. It asks Baldrick for local jobs, makes them on the 5090, uploads them and sends them to the approval queue — then stops."/>
          </ScrollViewer>
        </Border>
      </Grid>
    </TabItem>

    <!-- Methods: THE map — how each kind of thing is made. This grid IS the
         knowledge; Percy Worker reads this same table to dispatch. Editing a
         row here changes how the worker behaves, no code involved. -->
    <TabItem Header="Methods">
      <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
          <Button Content="Save changes" Style="{StaticResource Action}" Click="SaveMethods_Click"/>
          <Button Content="Reload" Style="{StaticResource Action}" Click="ReloadMethods_Click" Margin="8,0,0,0"/>
          <TextBlock x:Name="MethodsHint" VerticalAlignment="Center" FontSize="15"
                     Foreground="{StaticResource Muted}" Margin="12,0,0,0"
                     Text="How each kind of thing is made. New method = copy a workflow file, add a row."/>
        </StackPanel>

        <DataGrid x:Name="MethodsGrid" Grid.Row="1"
                  AutoGenerateColumns="False" CanUserAddRows="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
                  RowBackground="{StaticResource Panel}" AlternatingRowBackground="#20242B"
                  BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                  HorizontalGridLinesBrush="{StaticResource PanelEdge}"
                  FontSize="15" ColumnWidth="Auto"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="36"/>
            <DataGridTextColumn Header="Method" Binding="{Binding MethodKey}" Width="200"/>
            <DataGridTextColumn Header="Also answers to" Binding="{Binding Aliases}" Width="130"/>
            <DataGridTextColumn Header="What it makes" Binding="{Binding Label}" Width="240"/>
            <DataGridTextColumn Header="Engine" Binding="{Binding Engine}" Width="130"/>
            <DataGridTextColumn Header="Workflow file" Binding="{Binding WorkflowFile}" Width="300"/>
            <DataGridTextColumn Header="Finishing steps" Binding="{Binding Steps}" Width="180"/>
            <DataGridTextColumn Header="Injections (job value → workflow slot)" Binding="{Binding Injections}" Width="340"/>
            <DataGridTextColumn Header="Settings" Binding="{Binding Settings}" Width="220"/>
            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="380"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </TabItem>

    <!-- Baldrick: the CONTROLLER view — Baldrick's jobs, here, because this
         is the one queue. Approve/Reject finished runs, Retry/Cancel failures,
         Open jumps to the workbench page for the detail. Polls every 60s. -->
    <TabItem Header="Baldrick">
      <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
          <Button Content="Approve" Style="{StaticResource Action}" Click="BaldrickApprove_Click"/>
          <Button Content="Reject" Style="{StaticResource Action}" Click="BaldrickReject_Click" Margin="8,0,0,0"/>
          <TextBox x:Name="BaldrickReason" Width="220" Margin="8,0,0,0" FontSize="15"
                   Background="{StaticResource Panel}" Foreground="{StaticResource Ink}"
                   BorderBrush="{StaticResource PanelEdge}" VerticalContentAlignment="Center"
                   ToolTip="Reason — required for Reject, kept as the record"/>
          <Button Content="Retry" Style="{StaticResource Action}" Click="BaldrickRetry_Click" Margin="16,0,0,0"/>
          <Button Content="Cancel job" Style="{StaticResource Action}" Click="BaldrickCancel_Click" Margin="8,0,0,0"/>
          <Button Content="Open in Baldrick" Style="{StaticResource Action}" Click="BaldrickOpen_Click" Margin="16,0,0,0"/>
          <Button Content="Refresh" Style="{StaticResource Action}" Click="BaldrickRefresh_Click" Margin="8,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="BaldrickStatus" Grid.Row="0" FontSize="15"
                     Foreground="{StaticResource Muted}" Margin="0,0,0,8"
                     Text="Connecting to Baldrick…"/>
          <DataGrid x:Name="BaldrickGrid" Grid.Row="1"
                    AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
                    RowBackground="{StaticResource Panel}" AlternatingRowBackground="#20242B"
                    BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                    HorizontalGridLinesBrush="{StaticResource PanelEdge}"
                    FontSize="15" ColumnWidth="Auto"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="State" Binding="{Binding Kind}" Width="120"/>
              <DataGridTextColumn Header="Job" Binding="{Binding Process}" Width="300"/>
              <DataGridTextColumn Header="Workflow" Binding="{Binding Workflow}" Width="300"/>
              <DataGridTextColumn Header="Client" Binding="{Binding Client}" Width="60"/>
              <DataGridTextColumn Header="Queued" Binding="{Binding QueuedAt}" Width="150"/>
              <DataGridTextColumn Header="Can do" Binding="{Binding Actions}" Width="120"/>
              <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="360"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Grid>
    </TabItem>
    </TabControl>

    <!-- Footer -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
      <Button Content="Refresh" Style="{StaticResource Action}" Click="Refresh_Click"/>
      <TextBlock x:Name="Footer" VerticalAlignment="Center" FontSize="15"
                 Foreground="{StaticResource Muted}" Margin="8,0,0,0"/>
    </StackPanel>
  </Grid>
</Window>
