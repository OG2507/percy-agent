<Application x:Class="PercyAgent.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- Palette: quiet, dark, easy to glance at first thing in the morning. -->
    <SolidColorBrush x:Key="Bg"        Color="#14161A"/>
    <SolidColorBrush x:Key="Panel"     Color="#1C1F25"/>
    <SolidColorBrush x:Key="PanelEdge" Color="#2A2E36"/>
    <SolidColorBrush x:Key="Ink"       Color="#ECEEF2"/>
    <SolidColorBrush x:Key="Muted"     Color="#8B93A1"/>
    <SolidColorBrush x:Key="Accent"    Color="#E0813C"/>
    <SolidColorBrush x:Key="Danger"    Color="#E05A5A"/>
    <SolidColorBrush x:Key="Money"     Color="#E0B33C"/>
    <SolidColorBrush x:Key="Official"  Color="#5AA9E0"/>
    <SolidColorBrush x:Key="Good"      Color="#5FBF8F"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <!-- Display, not Ideal. Ideal takes WPF's DirectWrite path, which computes
           typography availability through MS.Internal.FontCache.MajorLanguages —
           and that type initializer throws on this machine (a broken WPF font
           cache, not a missing font; all 348 are present). It killed the window
           on 2026-08-07. Display uses the GDI-compatible path and never goes
           near it. Visually near-identical at these sizes. -->
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- Tabs. WPF's stock TabItem chrome is drawn for a light theme and comes out
         white on white against this background — invisible. -->
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,14,0,0"/>
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="7"
                    Padding="16,9" Margin="0,0,6,0"
                    BorderThickness="0,0,0,2" BorderBrush="Transparent">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Panel}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Flat, quiet buttons: this screen should not shout. -->
    <Style x:Key="Action" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="#252932"/>
      <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#30353F"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
      <Setter Property="Background" Value="#2E5C46"/>
      <Setter Property="BorderBrush" Value="#3C7A5C"/>
    </Style>

  </Application.Resources>
</Application>
